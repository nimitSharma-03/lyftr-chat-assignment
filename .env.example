# ---------------------------------------------------------------- backend
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
# Keys starting with "mock-" run an offline demo model (no provider call).
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
# LiteLLM model used by every key...
LLM_MODEL=gemini/gemini-2.5-flash
# ...or one model per key (same order as LLM_API_KEYS). Optional.
LLM_KEY_MODELS=
# SQLite location (four slashes = absolute path inside the container volume)
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# true enables the X-Simulate-Failure test header on POST /chat
ENABLE_FAILURE_SIMULATION=true
# Optional tuning
DEFAULT_SYSTEM_PROMPT=
CACHE_TTL_SECONDS=3600
KEY_COOLDOWN_SECONDS=30
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2
MAX_HISTORY_MESSAGES=40

# --------------------------------------------------------------- frontend
# Backend base URL the browser calls
VITE_API_URL=http://localhost:8000
